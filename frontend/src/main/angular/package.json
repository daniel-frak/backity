{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare-assets": "node scripts/copy-shared-assets.mjs",
    "prestart": "npm run prepare-assets",
    "start": "ng serve",
    "prebuild": "npm run prepare-assets",
    "build": "ng build",
    "prebuild-prod": "npm run prepare-assets",
    "build-prod": "ng build --configuration production",
    "prewatch": "npm run prepare-assets",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run prepare-assets",
    "test": "ng test",
    "pregenerate-test-coverage": "npm run prepare-assets",
    "generate-test-coverage": "ng test --coverage --no-watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "@stomp/rx-stomp": "^2.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@types/sockjs-client": "^1.5.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.1",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "istanbul-lib-instrument": "6.0.3",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "vitest-sonar-reporter": "3.0.0"
  }
}

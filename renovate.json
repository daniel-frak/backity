{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/src/test/resources/**"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "groupName": "mermaid",
      "matchPackageNames": [
        "mermaid",
        "astro-mermaid"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Update Testcontainers image versions in IMAGE_VERSION constants of classes in the dev.codesoapbox.backity.testing package",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)dev/codesoapbox/backity/testing/.+\\.java$/"
      ],
      "matchStrings": [
        "String\\s+IMAGE_VERSION\\s*=\\s*\"(?<depName>[^\"\\s]+?):(?<currentValue>[^\"\\s:@]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Update actionlint version GitHub workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)ACTIONLINT_REF:[ \\t]*'(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>[0-9a-f]{40})'"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{indentation}}}ACTIONLINT_REF: '{{{newValue}}}@{{{newDigest}}}'"
    }
  ],
  "platformAutomerge": true
}

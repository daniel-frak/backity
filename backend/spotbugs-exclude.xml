<FindBugsFilter>
    <Match>
        <Annotation name="~.*\.Generated"/>
    </Match>

    <!-- Exclude generated JPA metamodel classes -->
    <Match>
        <Class name="~.*_"/>
    </Match>

    <!-- Exclude generated MapStruct classes -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>